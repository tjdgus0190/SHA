{
  "name": "luminance-overlay-app",
  "version": "1.1.0",
  "description": "SHA Paint — Photoshop용 동명도 팔레트",
  "author": "SHA Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "uiohook-napi": "^1.5.5",
    "@miniben90/x-win": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shastudio.shapaint",
    "copyright": "Copyright © 2026 SHA Studio",
    "productName": "SHA Paint",
    "files": ["main.js", "com-bridge.js", "mac-bridge.js", "preload.js", "overlay.html", "overlay.js", "overlay.css", "colorMath.js", "settings.html", "settings.js", "settings-preload.js", "settings.css", "config.js", "i18n.js", "status-panel.html", "status-panel.js", "status-preload.js", "licensing.js", "license.html", "license-window.js", "license-preload.js", "icons/*"],
    "extraResources": [
      { "from": "resources/sha-paint-plugin.ccx", "to": "sha-paint-plugin.ccx" }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [{ "target": "zip", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.icns",
      "artifactName": "SHAPaintSetup-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "SHAPaintSetup-${version}.${ext}"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "multiLanguageInstaller": true,
      "installerLanguages": ["ko_KR", "en_US"],
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    }
  }
}
